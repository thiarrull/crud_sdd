<form action="<%= action %>" method="post" class="appointment-form">
  <div class="form-field">
    <label for="clientName">Nome do cliente</label>
    <input id="clientName" name="clientName" type="text" value="<%= appointment.clientName ?? '' %>" required>
  </div>
  <div class="form-field">
    <label for="service">Serviço</label>
    <input id="service" name="service" type="text" value="<%= appointment.service ?? '' %>" required>
  </div>
  <div class="form-row">
    <div class="form-field">
      <label for="appointmentDate">Data</label>
      <input id="appointmentDate" name="appointmentDate" type="date" value="<%= appointment.appointmentDate ?? '' %>" required>
    </div>
    <div class="form-field">
      <label for="appointmentTime">Horário</label>
      <input id="appointmentTime" name="appointmentTime" type="time" value="<%= appointment.appointmentTime ?? '' %>" required>
    </div>
  </div>
  <div class="form-field">
    <label for="notes">Observações <span>(opcional, até 500 caracteres)</span></label>
    <textarea id="notes" name="notes" rows="5" maxlength="500"><%= appointment.notes ?? '' %></textarea>
  </div>
  <div class="form-actions">
    <button type="submit"><%= submitLabel %></button>
    <a class="button button-secondary" href="/appointments">Cancelar</a>
  </div>
</form>
